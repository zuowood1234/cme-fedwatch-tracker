{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cme-fedwatch-push",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "triggers": {
    "crons": ["50 0 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
